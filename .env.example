# Copy this file to .env (in this folder, or the folder above it) and fill in ONE key.
# Never commit your real .env.

# Course gateway key (Portkey). The app only ever calls gpt-6-luna.
PORTKEY_API_KEY=

# Alternative: your own OpenAI key (used only if PORTKEY_API_KEY is empty).
OPENAI_API_KEY=

# Optional, for the hosted version only: lets the owner export pilot data at /api/admin/export.
# IBREADY_ADMIN_TOKEN=
